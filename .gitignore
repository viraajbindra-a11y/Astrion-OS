node_modules/
.DS_Store
.env
.claude/
# ...but the agent team is project config worth versioning (settings.local.json
# stays ignored above — it's machine-specific).
!.claude/agents/

# auto-push runtime logs (script + launchd)
scripts/auto-push.log
scripts/auto-push.launchd.out.log
scripts/auto-push.launchd.err.log

# M8.P5 soak target — written + restored by the apply/rollback soak
js/apps/.synthetic-target.js

# Kernel firmware (downloaded by kernel/scripts/get-ovmf.sh; ~4MB)
kernel/firmware/
kernel/build/

# Font sources + generation intermediates. The TTFs (~1.1MB) are fetched at
# generation time per kernel/tools/font/README.md; the atlas that actually
# builds is committed at kernel/src/af_font.h.
kernel/tools/font/*.ttf
kernel/tools/font/af_font.h
kernel/tools/font/af_preview.png

# Generated at build time by `make` (xxd of the sample ELF). Regenerated
# every build from progs/hello.c, so it's not committed.
kernel/src/hello_elf.h
