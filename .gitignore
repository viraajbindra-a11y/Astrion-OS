node_modules/
.DS_Store
.env
# Ignore .claude's CONTENTS (settings.local.json is machine-specific) but not the
# directory itself — git cannot re-include a file whose parent dir is excluded,
# so this must be `.claude/*`, not `.claude/`, for the negation below to work.
.claude/*
!.claude/agents/

# auto-push runtime logs (script + launchd)
scripts/auto-push.log
scripts/auto-push.launchd.out.log
scripts/auto-push.launchd.err.log

# M8.P5 soak target — written + restored by the apply/rollback soak
js/apps/.synthetic-target.js

# Kernel firmware (downloaded by kernel/scripts/get-ovmf.sh; ~4MB)
kernel/firmware/
kernel/build/

# UI-test leavings. The suite writes into kernel/build/uitest (already ignored),
# but the individual scripts default to writing beside themselves when run by
# hand — screenshots are megabytes of binary PPM and nothing here is a source.
__pycache__/
kernel/tools/*.ppm
kernel/tools/*.png
kernel/tools/*-serial.log

# Font sources + generation intermediates. The TTFs (~1.1MB) are fetched at
# generation time per kernel/tools/font/README.md; the atlas that actually
# builds is committed at kernel/src/af_font.h.
kernel/tools/font/*.ttf
kernel/tools/font/af_font.h
kernel/tools/font/af_preview.png

# Generated at build time by `make` (xxd of each user program's ELF).
# Regenerated every build from progs/*.c, so they're not committed —
# hello, rogue, iodemo, poke, peek.
kernel/src/*_elf.h

# CI ISOs downloaded into proof dirs for QEMU verification (~12MB each,
# reproducible via `gh run download`). Keep the AUDIT + frames, not the ISO.
tasks/**/iso/
tasks/**/iso-*/
